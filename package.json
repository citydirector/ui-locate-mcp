{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "ui-locate-mcp",
  "version": "0.6.0",
  "type": "module",
  "description": "Lightweight local visual grounding engine exposed as agent tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citydirector/ui-locate-mcp.git"
  },
  "exports": {
    ".": "./plugin/index.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "LICENSE",
    "cordis.patch.yml",
    "client.js",
    "plugin/index.mjs",
    "plugin/core.mjs",
    "plugin/tool.mjs",
    "plugin/runtime.mjs",
    "plugin/api.mjs",
    "plugin/trust.mjs",
    "locale/*.json",
    "icon.svg",
    "pyproject.toml",
    "uv.lock",
    ".python-version",
    "src/**/*.py",
    "scripts/*.ps1",
    "README.md",
    "market-index.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": []
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "main": "./plugin/index.mjs",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "computer-use",
    "screen",
    "locate",
    "ocr",
    "gui-automation",
    "vision"
  ]
}
